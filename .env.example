# cg-gateway configuration environment

# Server Binding
HOST=0.0.0.0
PORT=8560
DEBUG=false

# Access Protection (Optional: if set, clients must pass Bearer <KEY>)
PROXY_API_KEY=

# Upstream ChatGPT Configuration
CG_BASE_URL=https://chatgpt.com
CG_ACCOUNT_ID=fb88ebc3-79ae-45ff-b8b1-2313efa099b4

# Upstream Authentication (Optional: defaults to data/credentials.json)
CG_TOKEN=
CG_COOKIES=

# Session Pool Limits
MAX_SESSIONS=10
