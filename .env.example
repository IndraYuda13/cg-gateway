# cg-gateway configuration environment

# Server Binding
HOST=0.0.0.0
PORT=8560
DEBUG=false

# Optional Gateway Access Protection (Clients must pass: Authorization: Bearer <KEY>)
PROXY_API_KEY=

# Upstream Service Endpoint
CG_BASE_URL=https://chatgpt.com

# Target ChatGPT Workspace / Account UUID (Optional if single personal workspace)
CG_ACCOUNT_ID=

# Upstream Authentication (Optional if configured via data/credentials.json)
CG_TOKEN=
CG_COOKIES=

# Session Pool Limits
MAX_SESSIONS=10

# Persistent Data Storage Directory
DATA_DIR=./data
